{
  "name": "spiritual-os",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace @spiritual-os/web",
    "dev:mobile": "npm run start --workspace @spiritual-os/mobile",
    "build:web": "npm run build --workspace @spiritual-os/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:security": "npx tsx scripts/run-comprehensive-tests.js",
    "test:real-db": "npx tsx scripts/run-real-postgres-tests.ts",
    "test:fresh-migration": "npx tsx scripts/verify-fresh-supabase-migration.ts",
    "test:migration-compat": "npx tsx scripts/verify-migration-compat.ts",
    "test:backup-restore": "npx tsx scripts/verify-backup-restore.ts",
    "verify:staging": "npx tsx scripts/verify-hosted-staging.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.6.0-beta.19",
    "pg": "^8.23.1",
    "server-only": "^0.0.1"
  }
}
