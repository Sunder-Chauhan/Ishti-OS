# ==============================================================================
# ISHTI Environment Variables Template (.env.example)
# Internal Codename: spiritual-OS
# Public Brand: ISHTI
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CONFIGURATION (Exposed to browser / client bundles)
# ------------------------------------------------------------------------------
# Supabase Staging/Production project URL (e.g. https://your-staging-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Supabase Publishable Anon Key (RLS-restricted client key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key

# Mobile Application (Expo / React Native)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (Strictly private; never bundle into client or logs)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (Required for admin operations & rate limiter execution)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_service_role_key

# Kundli AES-256-GCM Envelope Encryption Key (64 hex characters = 32 bytes)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
KUNDLI_ENCRYPTION_KEY_V1=your_64_character_hex_encryption_key_32_bytes

# Rate Limiter HMAC-SHA-256 Identifier Key (Minimum 32 bytes UTF-8 or 64 hex chars)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
RATE_LIMIT_HMAC_SECRET=your_32_byte_minimum_rate_limit_hmac_secret

# ------------------------------------------------------------------------------
# 3. INFRASTRUCTURE & TRUSTED PROXY CONFIGURATION
# ------------------------------------------------------------------------------
# Active trusted proxy strategy ('cloudflare' | 'reverse_proxy' | 'direct' | 'none')
# Production default: cloudflare; Local development default: none
TRUSTED_PROXY_STRATEGY=cloudflare

# Cloudflare Origin Protection:
# Method A: Shared secret injected by Cloudflare Transform Rule in header x-ishti-edge-secret
CLOUDFLARE_EDGE_SECRET=your_32_char_edge_secret_token
# Method B: Set to "true" ONLY if origin is in private subnet / Cloudflare Tunnel (no direct ingress)
CLOUDFLARE_ORIGIN_PROTECTED=false

# Reverse Proxy (NGINX / AWS ALB) Origin Protection:
# Method A: Shared secret injected by proxy in header x-ishti-proxy-secret
REVERSE_PROXY_SHARED_SECRET=your_32_char_proxy_secret_token
# Method B: Set to "true" ONLY if origin is in private subnet / VPC with direct ingress blocked
REVERSE_PROXY_ORIGIN_PROTECTED=false

# Number of trusted reverse proxy hops for X-Forwarded-For parsing (default: 1)
TRUSTED_PROXY_HOPS=1
# Enable X-Real-IP extraction in reverse proxy mode (requires verified provenance)
TRUST_X_REAL_IP=false

# ------------------------------------------------------------------------------
# 4. THIRD-PARTY INTEGRATION CREDENTIALS (Sandbox / Test Mode)
# ------------------------------------------------------------------------------
# Phone OTP Provider (Twilio / SMS Gateway)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid

# Payment Gateway (Razorpay Sandbox)
RAZORPAY_KEY_ID=rzp_test_your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret
